# Database
DATABASE_URL=postgres://user:pass@host:5432/chronicle

# App URL (required for auth client in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
# R2 binding configured in wrangler.jsonc; public/custom bucket domain for media
NEXT_PUBLIC_R2_DOMAIN=
