{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chronicle",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "chronicle" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "chronicle" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://chronicle:chronicle@localhost:5432/chronicle_test",
    },
  ],
}
