{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chronicle",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "chronicle.siddhant.foo", "custom_domain": true }],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://chronicle.siddhant.foo",
    "BETTER_AUTH_URL": "https://chronicle.siddhant.foo",
    "NEXT_PUBLIC_R2_DOMAIN": "replace-with-public-r2-domain.example.invalid",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "chronicle" }],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "chronicle" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "chronicle-cache" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "chronicle-tags",
      "database_id": "00000000000000000000000000000000",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://chronicle:chronicle@localhost:5432/chronicle_test",
    },
  ],
}
